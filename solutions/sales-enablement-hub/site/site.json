    },
    {
      "order": 7,
      "title": "Content Requests",
      "url": "Lists/Content Requests",
      "definition": "site/lists/07-content-requests.json"
    },
    {
      "order": 8,
      "title": "Customer Shares",
      "url": "Lists/Customer Shares",
