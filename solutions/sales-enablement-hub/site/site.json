{
  "title": "Northwind Sales Hub",
  "description": "Find, build and share approved Northwind Cloud sales content.",
  "siteTemplate": "Communication site (SITEPAGEPUBLISHING#0), English (1033)",
  "homePage": "SitePages/Home.html",
  "header": {
    "HeaderLayout": 2,
    "HeaderEmphasis": 3,
    "logo": "HubAssets/nw-mark.png",
    "thumbnail": "HubAssets/nw-mark.png",
    "headerImage": "HubAssets/nw-header.png"
  },
  "theme": {
    "name": "Dark Teal",
    "how": "Out-of-the-box theme. Settings > Change the look > Theme > Dark Teal (manual; no tenant theme is required)."
  },
  "navigation": {
    "HorizontalQuickLaunch": true,
    "MegaMenuEnabled": true,
    "quickLaunch": [
      {
        "title": "Home",
        "url": "{{SitePath}}/SitePages/Home.html"
      },
      {
        "title": "Find",
        "url": "{{SitePath}}/SitePages/Find.html"
      },
      {
        "title": "Plays",
        "url": "{{SitePath}}/SitePages/Plays.html"
      },
      {
        "title": "Build a deck",
        "url": "{{SitePath}}/Deck Templates"
      },
      {
        "title": "Content team",
        "url": "{{SitePath}}/SitePages/PublishingDesk.html",
        "children": [
          {
            "title": "Publishing Desk",
            "url": "{{SitePath}}/SitePages/PublishingDesk.html"
          },
          {
            "title": "Content Intake",
            "url": "{{SitePath}}/Content Intake/Forms/AllItems.aspx"
          },
          {
            "title": "Content Library",
            "url": "{{SitePath}}/Content Library/Forms/AllItems.aspx"
          }
        ]
      }
    ]
  },
  "groups": [
    {
      "key": "Owners",
      "associated": "Owner",
      "title": "{{SiteTitle}} Owners",
      "role": "Full Control",
      "description": "Hub admins: full control, own the site skills, settings and navigation."
    },
    {
      "key": "Content Team",
      "associated": "Member",
      "title": "{{SiteTitle}} Content Team",
      "role": "Edit",
      "description": "Content team: publishes, reviews and approves content. Edit on the hub; sees Publishing Desk, Content Intake and Archive. Add people or a security group here.",
      "renameFrom": "{{SiteTitle}} Members"
    },
    {
      "key": "Sellers",
      "associated": "Visitor",
      "title": "{{SiteTitle}} Sellers",
      "role": "Read",
      "description": "Sellers: browse content, build decks, request content and share with customers. Read on the hub, Contribute where they create. Add people or a security group here.",
      "renameFrom": "{{SiteTitle}} Visitors"
    }
  ],
  "pages": [
    {
      "file": "Home.html",
      "title": "Home",
      "audience": "Everyone"
    },
    {
      "file": "Find.html",
      "title": "Find content",
      "audience": "Everyone"
    },
    {
      "file": "Plays.html",
      "title": "Plays",
      "audience": "Everyone"
    },
    {
      "file": "SlideBuilder.html",
      "title": "Slide gallery",
      "audience": "Everyone"
    },
    {
      "file": "PublishingDesk.html",
      "title": "Publishing Desk",
      "audience": "Owners + Content Team",
      "permissions": {
        "breakInheritance": true,
        "remove": [
          "Sellers"
        ]
      }
    }
  ],
  "lists": [
    {
      "order": 1,
      "title": "Content Intake",
      "url": "Content Intake",
      "definition": "site/lists/01-content-intake.json"
    },
    {
      "order": 2,
      "title": "Content Library",
      "url": "Content Library",
      "definition": "site/lists/02-content-library.json"
    },
    {
      "order": 3,
      "title": "Slide Library",
      "url": "Slide Library",
      "definition": "site/lists/03-slide-library.json"
    },
    {
      "order": 4,
      "title": "Deck Templates",
      "url": "Deck Templates",
      "definition": "site/lists/04-deck-templates.json"
    },
    {
      "order": 5,
      "title": "Decks",
      "url": "Generated Content",
      "definition": "site/lists/05-decks.json"
    },
    {
      "order": 6,
