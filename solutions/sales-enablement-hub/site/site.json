    }
  ],
  "tokens": {
    "{{SiteUrl}}": "Absolute URL of the target site, no trailing slash (https://contoso.sharepoint.com/sites/saleshub)",
    "{{SitePath}}": "Server-relative path of the site (/sites/saleshub)",
    "{{TenantUrl}}": "https://contoso.sharepoint.com",
    "{{TenantHost}}": "contoso.sharepoint.com",
    "{{SiteTitle}}": "Site title, used in group names",
    "{{SiteKey}}": "SharePoint IQ site key (IQ route only: get_site_key)",
    "{{ListId:<List title>}}": "GUID of a list after it is created",
    "{{ListIdB64:<List title>}}": "base64 of that GUID (form links)",
    "{{ViewId:<List>/<View>}}": "GUID of a view",
    "{{ViewIdB64:<List>/<View>}}": "base64 of that GUID (form links)",
    "{{FieldId:<List>/<Field>}}": "GUID of a column (form step)",
    "{{QuickStepId:<List>/<Quick step title>}}": "Id (RuleTemplateId) of a quick step after it is created",
    "{{GroupId:<Owners|Content Team|Sellers>}}": "Principal id of the site group",
    "{{ItemId:<Library>/<file name>}}": "List item id of an uploaded file",
    "{{ApproverEmail}} / {{ApproverName}}": "Content approver (person or mail-enabled group)",
    "{{OwnerEmail}}": "Default Content owner for the sample content (usually the deployer)",
    "{{Today}}, {{Today+N}}, {{Today-N}}": "Date relative to deploy day, written as yyyy-MM-ddT12:00:00Z, so the sample never goes stale"
  }
}
